{
  "name": "smriti-web",
  "private": true,
  "version": "1.0.0",
  "description": "A personal tracker for your work and what you learn: plan the day, log time, keep a reading list and revisit ideas. Runs on your computer in one container with one SQLite file.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/compress.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.7",
    "@tanstack/react-query": "5.62.7",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.1.11",
    "typescript": "5.7.2",
    "vite": "6.4.4"
  }
