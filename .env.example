# Copied to .env by `make env`. Everything else has a default; see docs/SPEC.md section 4.
# Published port on this machine.
SMRITI_PORT=8090
# 127.0.0.1 keeps Smriti on this machine only; 0.0.0.0 makes it reachable from your phone on the same network.
SMRITI_BIND=127.0.0.1
# Time zone for "today" and plain dates.
TZ=Asia/Kolkata
# Dev only: port of the Vite dev server (make dev).
SMRITI_WEB_PORT=5190
# Obsidian export (optional). The full path of your Obsidian vault on this computer, and the folders
# inside it for notes. Leave SMRITI_VAULT_PATH empty to keep the feature off.
SMRITI_VAULT_PATH=
SMRITI_OBSIDIAN_FOLDER=Smriti/Learning
SMRITI_OBSIDIAN_ARTICLES_FOLDER=Smriti/Articles
# on: every source is saved to the vault when you add or edit it. off: only the gem button saves.
SMRITI_OBSIDIAN_AUTO=on
